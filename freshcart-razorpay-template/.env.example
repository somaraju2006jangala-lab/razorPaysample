# Fresh-Cart Razorpay Payment Gateway Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Razorpay API Credentials (Get from Razorpay Dashboard > Settings > API Keys)
# In Test Mode: Starts with rzp_test_...
# In Live Mode: Starts with rzp_live_...
RAZORPAY_KEY_ID=rzp_test_U0QHmuD7XKXq3a
RAZORPAY_KEY_SECRET=uClaP7qRk46CP0coCCFxxRgg

# Razorpay Webhook Secret (Configured in Razorpay Dashboard > Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Environment Mode: 'test' or 'live'
PAYMENT_MODE=test

# Database Configuration (SQLite file path or PostgreSQL connection string)
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/freshcart_payments.db
# If using PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/freshcart_payments

# Frontend URL (For CORS and redirect callbacks)
FRONTEND_URL=http://localhost:5173

# Admin Portal Secret Key (For JWT tokens and admin operations like refunds)
ADMIN_SECRET_KEY=freshcart_secure_admin_secret_key_2026_change_me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=freshcart_admin_secure

# Currency & Defaults
DEFAULT_CURRENCY=INR

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

